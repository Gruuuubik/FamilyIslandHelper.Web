@using FamilyIslandHelper.Api;
@using System.Collections;
@using FamilyIslandHelper.Api.Models.Abstract;
@using System.Web
@model CompareViewModel
@{
	ViewData["Title"] = "Калькулятор компонентов Family Island";
}

<header class="mb-4 mt-3">
	<h1 class="h3">Family Island Helper</h1>
	<p class="lead mb-2">
		Калькулятор компонентов для зданий Family Island: узнайте, какие ресурсы
		нужны для производства предметов, и сравните два предмета между собой.
	</p>
	<ol class="text-muted small">
		<li>Выберите, сколько предметов сравнивать: 1 или 2.</li>
		<li>Выберите здание, затем предмет в нём.</li>
		<li>Укажите, сколько предметов нужно произвести.</li>
		<li>Включите нужные переключатели, чтобы увидеть список компонентов и энергию.</li>
	</ol>
</header>

<form id="mainFormCompare" method="get" action="~/Compare/Index">
	<div class="d-flex flex-wrap align-items-center gap-3 mb-2">
		<div id="apiVersionSelector" class="d-flex align-items-center gap-2">
			<span>Версия API:</span>
			<div class="segmented" role="radiogroup" aria-label="Версия API">
				<input id="ApiVersionCompare1" name="ApiVersion" type="radio" value="v1" checked="@(Model.ApiVersion == ApiVersion.v1)">
				<label for="ApiVersionCompare1">v1</label>
				<input id="ApiVersionCompare2" name="ApiVersion" type="radio" value="v2" checked="@(Model.ApiVersion == ApiVersion.v2)">
				<label for="ApiVersionCompare2">v2</label>
			</div>
		</div>
		<div id="itemsCountSelector" class="d-flex align-items-center gap-2">
			<span>Сколько предметов сравнивать:</span>
			<div class="segmented" role="radiogroup" aria-label="Сколько предметов сравнивать">
				<input id="ItemsCountOnView1" name="ItemsCountOnView" type="radio" value="1" checked="@(Model.ItemsCountOnView == 1)">
				<label for="ItemsCountOnView1">1</label>
				<input id="ItemsCountOnView2" name="ItemsCountOnView" type="radio" value="2" checked="@(Model.ItemsCountOnView == 2)">
				<label for="ItemsCountOnView2">2</label>
			</div>
		</div>
	</div>

	@if (Model.ItemsCountOnView == 2)
	{
		<div>
			<textarea id="ItemCompareInfo" readonly>@Model.ItemCompareInfo</textarea>
		</div>
	}

	<div id="CommonSettings" class="commonSettings">
		<div class="checkbox-wrapper-14">
			@Html.CheckBoxFor(m => m.ShowListOfComponentsForAll, new { @class = "switch" })
			@Html.LabelFor(m => m.ShowListOfComponentsForAll)
		</div>
		<div class="checkbox-wrapper-14">
			@Html.CheckBoxFor(m => m.ShowComponentsWithEnergyForAll, new { @class = "switch" })
			@Html.LabelFor(m => m.ShowComponentsWithEnergyForAll)
		</div>
	</div>

	<div class="float-container">
		<div class="float-child">
			<div id="Component1" class="component">
				<div class="small text-muted mb-1">Здание</div>
				<div id="BuildingsImages1">
					@foreach (var buildingName1 in @Model.BuildingsNames)
					{
						var classes = "buildingImageName";
						if (buildingName1 == @Model.BuildingName1)
						{
							classes += " selectedImage";
						}
						<img class="@classes" id="@buildingName1" width="60" height="60" loading="lazy" onclick="setBuildingName(event, 'BuildingName1');" src="/resources/@Model.ApiVersion/@buildingName1" alt="@Model.GetDisplayName(buildingName1)" title="@Model.GetDisplayName(buildingName1)">
					}
					<input type="hidden" name="BuildingName1" id="BuildingName1" value="@Model.BuildingName1" />
				</div>
				<div class="small text-muted mt-2 mb-1">Предмет</div>
				<div id="ItemsImages1">
					@foreach (var itemName1 in @Model.Items1)
					{
						var classes = "itemNameImage";
						if (itemName1 == @Model.ItemName1)
						{
							classes += " selectedImage";
						}
						<img class="@classes" id="@itemName1" width="60" height="60" loading="lazy" onclick="setItemName(event, 'ItemName1');" src="/resources/@Model.ApiVersion/@Model.BuildingName1/@itemName1" alt="@Model.GetDisplayName(itemName1)" title="@Model.GetDisplayName(itemName1)">
					}
					<input type="hidden" name="ItemName1" id="ItemName1" value="@Model.ItemName1" />
				</div>
				<div>
					@Html.LabelFor(m => m.ItemCount1)
					<input type="number" class="itemCount" id="ItemCount1" name="ItemCount1" min="1" max="20" value="@Model.ItemCount1" />
				</div>
				<h2 class="h5 mt-3">@Model.ResultTitle1</h2>
				@if (Model.ShowComponentsWithEnergyForAll)
				{
					<div>
						<textarea id="ItemInfo1" class="personal" readonly>@Model.ItemInfo1</textarea>
					</div>
				}
				@if (Model.ShowListOfComponentsForAll)
				{
					<div>
						<label>Компоненты:</label>
						@Html.Raw(HttpUtility.HtmlDecode(@Model.ComponentsTreeHtml1))
					</div>
				}
			</div>
		</div>

		@if (Model.ItemsCountOnView == 2)
		{
			<div class="float-child">
				<div id="Component2" class="component">
					<div class="small text-muted mb-1">Здание</div>
					<div id="BuildingsImages2">
						@foreach (var buildingName2 in @Model.BuildingsNames)
						{
							var classes = "buildingImageName";
							if (buildingName2 == @Model.BuildingName2)
							{
								classes += " selectedImage";
							}
							<img class="@classes" id="@buildingName2" width="60" height="60" loading="lazy" onclick="setBuildingName(event, 'BuildingName2');" src="/resources/@Model.ApiVersion/@buildingName2" alt="@Model.GetDisplayName(buildingName2)" title="@Model.GetDisplayName(buildingName2)">
						}
						<input type="hidden" name="BuildingName2" id="BuildingName2" value="@Model.BuildingName2" />
					</div>
					<div class="small text-muted mt-2 mb-1">Предмет</div>
					<div id="ItemsImages2">
						@foreach (var itemName2 in @Model.Items2)
						{
							var classes = "itemNameImage";
							if (itemName2 == @Model.ItemName2)
							{
								classes += " selectedImage";
							}
							<img class="@classes" id="@itemName2" width="60" height="60" loading="lazy" onclick="setItemName(event, 'ItemName2');" src="/resources/@Model.ApiVersion/@Model.BuildingName2/@itemName2" alt="@Model.GetDisplayName(itemName2)" title="@Model.GetDisplayName(itemName2)">
						}
						<input type="hidden" name="ItemName2" id="ItemName2" value="@Model.ItemName2" />
					</div>
					<div>
						@Html.LabelFor(m => m.ItemCount2)
						<input type="number" class="itemCount" id="ItemCount2" name="ItemCount2" min="1" max="20" value="@Model.ItemCount2" />
					</div>
					<h2 class="h5 mt-3">@Model.ResultTitle2</h2>
					@if (Model.ShowComponentsWithEnergyForAll)
					{
						<div>
							<textarea id="ItemInfo2" class="personal" readonly>@Model.ItemInfo2</textarea>
						</div>
					}
					@if (Model.ShowListOfComponentsForAll)
					{
						<div>
							<label>Компоненты:</label>
							@Html.Raw(HttpUtility.HtmlDecode(@Model.ComponentsTreeHtml2))
						</div>
					}
				</div>
			</div>
		}
	</div>
</form>